NODE_ENV=development
PORT=4000

# Supabase: Project Settings > API. The service key must stay on this server.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

# Generate with `npm run keys:gate`. Put the public half in the frontend's env.
GATE_PASS_PRIVATE_KEY=
GATE_PASS_TTL_HOURS=8

# Comma-separated list of origins allowed to call this API.
FRONTEND_ORIGIN=http://localhost:3000
# Proxies between the internet and this process (2 on Render behind a Vercel rewrite).
TRUST_PROXY_HOPS=1

# Leave SMTP_HOST empty to log mail to the console instead of sending it.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Serein <no-reply@serein.app>
# Receives a note whenever a recovery request arrives.
OWNER_NOTIFY_EMAIL=

# At least 32 characters. Lets a scheduler call POST /jobs/reminders; leave empty to turn it off.
JOBS_SECRET=
